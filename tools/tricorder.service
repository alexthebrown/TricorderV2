# Start the tricorder at boot without a desktop session (console / KMS mode).
#   sudo cp tools/tricorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tricorder
[Unit]
Description=Tricorder
After=network-online.target remote-fs.target
Wants=network-online.target

[Service]
User=tricorder
Group=tricorder
SupplementaryGroups=video render input gpio audio
WorkingDirectory=/home/tricorder/Desktop/Tricorder/TricorderV2
ExecStart=/home/tricorder/Desktop/Tricorder/TricorderV2/build/tricorder --fullscreen
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
