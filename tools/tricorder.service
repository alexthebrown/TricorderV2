# Boot straight into the tricorder, full screen, with no desktop (console / KMS mode).
#   sudo cp tools/tricorder.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now tricorder
# EXIT PROGRAM on the INPUT page drops to the console login; SHUT DOWN powers off.
[Unit]
Description=Tricorder
# No network wait: the tricorder works offline and picks up Wi-Fi whenever it appears.
After=systemd-user-sessions.service
# Own the screen instead of the console login prompt on tty1.
Conflicts=getty@tty1.service
After=getty@tty1.service
# Keep retrying rather than giving up if something goes wrong at boot.
StartLimitIntervalSec=0

[Service]
User=tricorder
Group=tricorder
SupplementaryGroups=video render input gpio audio
WorkingDirectory=/home/tricorder/Desktop/Tricorder/TricorderV2
Environment=SDL_VIDEODRIVER=kmsdrm
# The Pi Zero's display driver can still be loading this early in boot: wait for it.
ExecStartPre=/bin/sh -c 'for i in $(seq 30); do [ -e /sys/class/drm/card0-Composite-1 ] || [ -e /sys/class/drm/card1-Composite-1 ] || [ -e /dev/dri/card0 ] && exit 0; sleep 1; done; exit 0'
ExecStart=/home/tricorder/Desktop/Tricorder/TricorderV2/build/tricorder --fullscreen
# Bring the console back only when the program is exited on purpose (a crash restarts it
# instead; starting the console then would cancel the restart). "+" runs this as root.
ExecStopPost=+/bin/sh -c '[ "$SERVICE_RESULT" = success ] && systemctl --no-block start getty@tty1.service || true'
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
